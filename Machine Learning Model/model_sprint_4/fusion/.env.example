# Fusion deployment configuration
# Copy and edit for local development or Hugging Face Spaces deployment.

FUSION_MODE=local
FUSION_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# Specialist endpoints (used when FUSION_MODE=api)
SEMANTIC_URL=
INFRASTRUCTURE_URL=
RUNTIME_URL=
VISUAL_URL=

# Specialist toggles
SEMANTIC_ENABLED=true
INFRASTRUCTURE_ENABLED=true
RUNTIME_ENABLED=true
VISUAL_ENABLED=false

# Timeouts (seconds)
SPECIALIST_TIMEOUT=120
SPECIALIST_RETRIES=1
HTTP_TIMEOUT=120

# Model paths (relative to fusion/)
FUSION_MODEL_DIR=model/base
FUSION_TOKENIZER_DIR=model/tokenizer
FUSION_ADAPTER_DIR=model/adapter
